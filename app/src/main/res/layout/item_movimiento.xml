<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="56dp">

    <!-- ===================== Movimiento ===================== -->

    <!-- Avatar -->

    <FrameLayout
        android:id="@+id/avatarContainer"
        android:layout_width="40dp"
        android:layout_height="40dp"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/imgUsuarioMovimiento"
            android:layout_width="@dimen/pic_mm"
            android:layout_height="@dimen/pic_mm"
            android:src="@drawable/user_default"
            android:contentDescription="Imagen de usuario" />

        <FrameLayout
            android:id="@+id/badgeMovimiento"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="-9dp"
            android:layout_marginBottom="-9dp">

            <ImageView
                android:id="@+id/imgFondoBadge"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/circle"
                android:contentDescription="@null" />

            <ImageView
                android:id="@+id/imgTipoMovimiento"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center"
                android:src="@drawable/star_var"
                android:contentDescription="Tipo de movimiento" />

        </FrameLayout>

    </FrameLayout>


    <!-- Nombre / usuario relacionado -->

    <TextView
        android:id="@+id/tvNombreMovimiento"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginStart="@dimen/margin_sd"

        android:text="defaultName"
        android:textColor="@color/negro"
        android:textSize="@dimen/text_sx"
        android:textStyle="bold"

        app:layout_constraintStart_toEndOf="@id/avatarContainer"
        app:layout_constraintTop_toTopOf="@id/avatarContainer" />


    <!-- Fecha -->

    <TextView
        android:id="@+id/tvFechaMovimiento"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:layout_marginTop="@dimen/spacing_uxs"

        android:text="Mes DD, HH:MM"
        android:textColor="@color/negro"
        android:textSize="@dimen/text_sd"

        app:layout_constraintStart_toStartOf="@id/tvNombreMovimiento"
        app:layout_constraintTop_toBottomOf="@id/tvNombreMovimiento" />


    <!-- Monto -->

    <TextView
        android:id="@+id/tvMontoMovimiento"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:text="$mount"
        android:textColor="@color/negro"
        android:textSize="@dimen/text_sd"
        android:textStyle="bold"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
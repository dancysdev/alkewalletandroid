<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_3">

    <!-- Encabezado -->

    <TextView
        android:id="@+id/tvSignupTitle"
        android:layout_width="315dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"
        android:text="Regístrate y empieza a transferir!"
        android:textColor="@color/black"
        android:textSize="32sp"
        android:fontFamily="@font/jua"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Nombre -->

    <EditText
        android:id="@+id/etNombre"
        android:layout_width="315dp"
        android:layout_height="49dp"
        android:inputType="text"
        android:hint="Nombre"
        android:textSize="16sp"
        android:paddingHorizontal="26dp"
        android:textColorHint="@color/black"
        android:background="@drawable/bg_et"
        app:layout_constraintTop_toBottomOf="@id/tvSignupTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="35dp" />

    <!-- Apellido -->

    <EditText
        android:id="@+id/etApellido"
        android:layout_width="315dp"
        android:layout_height="49dp"
        android:inputType="text"
        android:hint="Apellido"
        android:textSize="16sp"
        android:paddingHorizontal="26dp"
        android:textColorHint="@color/black"
        android:background="@drawable/bg_et"
        app:layout_constraintTop_toBottomOf="@id/etNombre"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="25dp" />

    <!-- e-mail -->
        <EditText
            android:id="@+id/etEmail"
            android:layout_width="315dp"
            android:layout_height="49dp"
            android:hint="Ingresa tu e-mail"
            android:textSize="16sp"
            android:textColorHint="@color/black"
            android:inputType="textEmailAddress"
            android:paddingHorizontal="26dp"
            android:background="@drawable/bg_et"
            app:layout_constraintTop_toBottomOf="@id/etApellido"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="25dp" />



    <!-- Contraseña -->

    <EditText
        android:id="@+id/etPasswordMake"
        android:layout_width="315dp"
        android:layout_height="49dp"
        android:hint="Crea tu contraseña"
        android:textSize="16sp"
        android:textColorHint="@color/black"
        android:inputType="textPassword"
        android:paddingHorizontal="26dp"
        android:background="@drawable/bg_et"
        android:drawableEnd="@drawable/ic_eye"
        app:layout_constraintTop_toBottomOf="@id/etEmail"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="25dp"/>

    <!-- Confirmar contraseña -->

    <EditText
        android:id="@+id/etPasswordConfirm"
        android:layout_width="315dp"
        android:layout_height="49dp"
        android:hint="Confirma tu contraseña"
        android:textSize="16sp"
        android:textColorHint="@color/black"
        android:inputType="textPassword"
        android:paddingHorizontal="26dp"
        android:background="@drawable/bg_et"
        android:drawableEnd="@drawable/ic_eye"
        app:layout_constraintTop_toBottomOf="@id/etPasswordMake"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="25dp"/>



    <!-- Botón de registro -->

        <Button
            android:id="@+id/btnMakeAccount"
            android:layout_width="315dp"
            android:layout_height="49dp"
            android:text="Crear cuenta"
            android:textColor="@color/white"
            android:fontFamily="@font/jua"
            android:background="@drawable/button_third"
            app:backgroundTint="@null"
            app:layout_constraintBottom_toTopOf="@id/tvYaTieneCuenta"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="24dp"/>

        <!-- Título linkeable reutilizable-->

    <TextView
        android:id="@+id/tvYaTieneCuenta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ya_tiene_cuenta"
        android:textColor="@color/pregunta_blue"
        android:textSize="16sp"
        android:fontFamily="@font/jua"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="32dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>

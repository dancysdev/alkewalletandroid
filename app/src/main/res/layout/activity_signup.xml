<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_3">

    <!-- Encabezado -->

    <TextView
        android:id="@+id/tvSignupTitle"
        android:layout_width="@dimen/et_tlsx"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_psl"
        android:text="@string/registrarTitle"

        android:textSize="@dimen/text_ld"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Nombre -->

    <EditText
        android:id="@+id/etNombre"
        style="@style/EditText"
        android:layout_width="@dimen/et_tlsx"
        android:layout_height="@dimen/et_ups"
        android:inputType="text"
        android:hint="@string/userName"
        android:focusable="true"
        android:paddingHorizontal="26dp"
        android:paddingVertical="13dp"

        app:layout_constraintTop_toBottomOf="@id/tvSignupTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/margin_psl" />

    <!-- Apellido -->

    <EditText
        android:id="@+id/etApellido"
        style="@style/EditText"
        android:layout_width="@dimen/et_tlsx"
        android:layout_height="@dimen/et_ups"
        android:inputType="text"
        android:hint="@string/userApellido"
        android:focusable="true"
        android:paddingHorizontal="26dp"
        android:paddingVertical="13dp"

        app:layout_constraintTop_toBottomOf="@id/etNombre"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/margin_mx" />

    <!-- e-mail -->
        <EditText
            android:id="@+id/etEmail"
            style="@style/EditText"
            android:layout_width="@dimen/et_tlsx"
            android:layout_height="@dimen/et_ups"
            android:hint="@string/email"
            android:focusable="true"
            android:textSize="16sp"
            android:inputType="textEmailAddress"
            android:paddingHorizontal="26dp"
            android:paddingVertical="13dp"

            app:layout_constraintTop_toBottomOf="@id/etApellido"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="@dimen/margin_mx" />



    <!-- Contraseña -->

    <EditText
        android:id="@+id/etPasswordMake"
        style="@style/EditText"
        android:layout_width="@dimen/et_tlsx"
        android:layout_height="@dimen/et_ups"
        android:hint="@string/pass"
        android:textSize="16sp"
        android:focusable="true"
        android:inputType="textPassword"
        android:paddingHorizontal="26dp"
        android:paddingVertical="13dp"
        android:drawableEnd="@drawable/ic_eye"
        app:layout_constraintTop_toBottomOf="@id/etEmail"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/margin_mx" />

    <!-- Confirmar contraseña -->

    <EditText
        android:id="@+id/etPasswordConfirm"
        style="@style/EditText"
        android:layout_width="@dimen/et_tlsx"
        android:layout_height="@dimen/et_ups"
        android:hint="@string/cPass"
        android:focusable="true"
        android:inputType="textPassword"
        android:paddingHorizontal="26dp"
        android:paddingVertical="13dp"

        android:drawableEnd="@drawable/ic_eye"
        app:layout_constraintTop_toBottomOf="@id/etPasswordMake"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="25dp"/>

    <!-- Botón de registro -->

    <Button
        android:id="@+id/btnMakeAccount"
        app:backgroundTint="@null"
        style="@style/ButtonBlue2"
        android:layout_width="@dimen/et_tlsx"
        android:layout_height="@dimen/et_ups"
        android:layout_marginBottom="@dimen/margin_m"

        android:text="@string/crearCuenta"
        app:layout_constraintBottom_toTopOf="@id/tvYaTieneCuenta"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />


    <!-- Título linkeable reutilizable-->

    <TextView
        android:id="@+id/tvYaTieneCuenta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tieneCuenta"
        android:textColor="@color/azul_font"
        android:textSize="@dimen/text_uxm"

        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="@dimen/margin_ld"/>

</androidx.constraintlayout.widget.ConstraintLayout>
